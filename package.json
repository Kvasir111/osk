{
  "name": "osk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/build-pwa.mjs && pnpm run test:functions",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup:profiles": "node --env-file-if-exists=.env scripts/setup-profile-storage.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:functions": "node scripts/test-functions.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "4.3.3",
    "h3": "1.15.11",
    "nuxt": "4.6.3",
    "openai": "7.45.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@netlify/functions": "6.0.3",
    "@netlify/zip-it-and-ship-it": "16.6.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}

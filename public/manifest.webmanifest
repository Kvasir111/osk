{
  "id": "/",
  "name": "Ósk · Wishes, kept simply",
  "short_name": "Ósk",
  "description": "Keep wishes from any store, share with your people, and add things offline.",
  "lang": "en-US",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f7f7",

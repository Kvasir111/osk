  "share_target": {
    "action": "/capture",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [{ "name": "Add a wish", "short_name": "Quick capture", "url": "/capture", "description": "Save a product link or photo reference" }],
  "icons": [
    { "src": "/icons/osk-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/osk-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/osk-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}

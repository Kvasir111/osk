# Public, available in the browser.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix these with NUXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated verified account emails allowed to invite new users (server only).
INVITATION_ADMIN_EMAILS=
# Default: scrape saved product pages without paid AI calls. Set to ai only to restore the retained agent.
PRODUCT_RESEARCH_MODE=scrape
# Optional; used only when PRODUCT_RESEARCH_MODE=ai.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: override interactive background research independently.
# OPENAI_SEARCH_MODEL=gpt-5.4-mini
# Optional: structured formatting model for legacy/daily synchronous checks.
# OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
# Generate with: openssl rand -hex 32
PRICE_REFRESH_SECRET=
# Netlify provides URL automatically; set for local background dispatch testing.
# URL=https://your-site.netlify.app
